{
  "name": "@pako/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate:api-client": "nswag openapi2tsclient /input:http://127.0.0.1:5248/openapi/v1.json /output:src/generated/api-client.ts /template:Fetch /className:PakoApiClient /generateClientClasses:true /generateDtoTypes:true /typeStyle:Interface /dateTimeType:String /nullValue:Undefined"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "nswag": "^14.0.0",
    "typescript": "~5.9.3"
  }
}
